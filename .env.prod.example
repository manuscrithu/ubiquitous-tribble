# Postgres
POSTGRES_USER=shortener
POSTGRES_PASSWORD=changeme_use_a_real_password
POSTGRES_DB=shortener_db

# Backend
SECRET_KEY=changeme_use_openssl_rand_hex_32

# Frontend
# This is the public URL users' browsers use to reach the API
# After Phase 4, this should be https://yourdomain.com/api
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# GitHub repository path (used to construct ghcr.io image names)
# Format: your-github-username/your-repo-name
GITHUB_REPOSITORY=manuscrithu/ubiquitous-tribble

# Observability (added in Phase 6)
GRAFANA_PASSWORD=changeme_use_a_real_password